# このファイルは GCP 統制スクリプト（scripts/gcp_*.sh）と make gcp-* 用。
# 使い方: cp .env.example .env して埋め、`set -a; source .env; set +a`
#
# エージェント自身の設定（プロジェクトID / モデル / 認証）は
# 各 agents-cli プロジェクトの .env を使う:
#   receipt-agent/.env  policy-agent/.env  expense-orchestrator/.env

GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
ORG_ID=123456789012
STAGING_BUCKET=your-staging-bucket

# gcp-deploy: 設定するとオーケストレータの egress をゲートウェイに固定する
# AGENT_GATEWAY=projects/.../locations/us-central1/agentGateways/expense-gw

# gcp-iam: gcp-deploy の出力に出る Agent Engine ID
# AGENT_ENGINE_ID=

# gcp-iam: 設定したときだけ領収書バケットの読み取りを付与する
# RECEIPTS_BUCKET=

# gcp-registry: Runtime 外（Cloud Run 等）に立てたエージェントの公開URL
# AGENT_BASE_URL=https://policy-agent-xxxx.a.run.app

# オーケストレータを Agent Registry 解決に切り替える
# USE_AGENT_REGISTRY=1

# モデルの差し替え（3プロジェクト共通で効く）
# ADK_MODEL=gemini-3.7-flash
